---
import { Shield, Home, Zap, Activity, BarChart3, Database, Cpu, Settings, LogOut } from "lucide-react";

const menuItems = [
	{ icon: Home, label: "Dashboard", active: true },
	{ icon: Zap, label: "Threat Intel" },
	{ icon: Activity, label: "Monitoring" },
	{ icon: BarChart3, label: "Analytics" },
	{ icon: Database, label: "Transactions" },
	{ icon: Cpu, label: "Model Insights" },
];
---

<aside class="fixed left-0 top-0 h-screen w-20 flex flex-col items-center py-8 bg-surface border-r border-border z-[100] transition-colors duration-300">
	<div class="mb-12">
		<div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center border border-primary/20 shadow-sm group cursor-pointer hover:border-primary/40 transition-all">
			<Shield className="w-6 h-6 text-primary" />
		</div>
	</div>

	<nav class="flex-1 flex flex-col gap-6">
		{menuItems.map((item) => (
			<button class={`p-3 rounded-xl transition-all group relative ${item.active ? 'bg-primary text-white shadow-lg shadow-primary/20' : 'text-muted hover:bg-background hover:text-primary'}`}>
				<item.icon size={20} strokeWidth={item.active ? 2.5 : 2} />
				<div class="absolute left-full ml-4 px-3 py-1.5 bg-card border border-border rounded-lg text-[10px] font-black uppercase tracking-widest opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all whitespace-nowrap z-50 shadow-xl">
					{item.label}
				</div>
			</button>
		))}
	</nav>

	<div class="mt-auto flex flex-col gap-6">
		<button class="p-3 rounded-xl text-muted hover:bg-background hover:text-primary transition-all">
			<Settings size={20} />
		</button>
		<button class="p-3 rounded-xl text-danger/60 hover:bg-danger/10 hover:text-danger transition-all">
			<LogOut size={20} />
		</button>
	</div>
</aside>
